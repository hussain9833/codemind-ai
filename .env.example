# Copy to .env.local and fill in. NEVER commit .env.local or put real values in this file.
# All of these are server-only: none use the NEXT_PUBLIC_ prefix, so none reach the browser.
# Do not set NODE_ENV here: Next.js sets it, and "development" breaks `next build`.

APP_URL=http://localhost:3000

# ── Neon PostgreSQL ────────────────────────────────────────────
# Runtime connection: Neon *pooled* host (contains "-pooler"). Keep pgbouncer=true so Prisma
# does not use prepared statements through the pooler.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Migrations connection: Neon *direct* host (no "-pooler").
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Encryption (GitHub tokens at rest) ─────────────────────────
# Must decode to exactly 32 bytes. Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# ── GitHub App ─────────────────────────────────────────────────
# Settings -> Developer settings -> GitHub Apps -> your app
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Paste the .pem with newlines replaced by \n, wrapped in double quotes.
GITHUB_APP_PRIVATE_KEY=

# ── NVIDIA NIM (server-side only) ──────────────────────────────
NVIDIA_API_KEY=
# Optional overrides
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=google/gemma-4-31b-it
# Comma-separated; tried in order if the primary stalls (>20s) or is unavailable.
NVIDIA_CHAT_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b,meta/llama-3.2-11b-vision-instruct
# Dimension is read from the model at runtime (nemotron-3-embed-1b returns 2048).
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
