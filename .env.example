

# ── Email for password-reset codes (SMTP) ──────────────────────
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords (16 characters, spaces are fine).
# Leave blank in local dev to have the code printed in the server console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional sender name, e.g. "CodeMind AI <you@gmail.com>" (defaults to SMTP_USER)
MAIL_FROM=
